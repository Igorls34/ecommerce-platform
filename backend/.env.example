# Honeypot - Rotas armadilha para monitoramento de acessos nao autorizados
# Ativar com HONEYPOT_ENABLED=true quando o site for para producao
# Coleta logs e envia alertas por e-mail quando detects acessos suspeitos
HONEYPOT_ENABLED=false

# Email transacional
# Em producao, MAIL_FROM deve ser um remetente validado/autorizado pelo provedor.
# Suporta Mailtrap API, Brevo, Resend, SendGrid, Amazon SES, Postmark ou SMTP generico.
MAILTRAP_API_TOKEN=
MAIL_FROM=contato@thessarasemijoias.com.br
MAIL_FROM_NAME=Thessara
SEND_EMAILS_IN_TESTS=false
SEND_ADMIN_PENDING_ORDER_EMAIL=true

# Email SMTP fallback
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false

# Shipping
MELHOR_ENVIO_TOKEN=
