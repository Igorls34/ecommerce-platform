generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// UTILIZADORES E CLIENTES
// ==========================================

model AdminUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // A palavra-passe deverá ser encriptada (ex: bcrypt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?  // Pode ser nulo para clientes que só fizeram cadastro via lead form
  googleId  String?  @unique
  cpf       String?  @unique // Muito útil para pagamentos e faturação
  phone     String?
  notifyWhatsApp Boolean @default(false) // Coleta permissão/preferência; não há envio automático via WhatsApp hoje
  preferredContact String? // 'email' ou 'whatsapp' para uso operacional
  avatarUrl String?
  leadSource String?
  lastLoginAt DateTime?
  marketingOptIn Boolean @default(false)
  defaultAddress Json?
  orders    Order[]  // Relação: Um cliente pode ter várias encomendas
  availabilityLeads ProductAvailabilityLead[]
  passwordResetTokens PasswordResetToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(64)
  customerId Int
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

// ==========================================
// CATÁLOGO DE PRODUTOS
// ==========================================

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  imageUrl  String?
  visible   Boolean   @default(true)
  products  Product[] // Relação: Uma categoria tem vários produtos
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  sku         String?
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  visible     Boolean     @default(true)
  weight      Decimal?    @db.Decimal(8, 3)
  unit        String?     @default("UN")
  ncm         String?     @db.VarChar(10)
  cfop        String?     @db.VarChar(6)
  imageUrl    String?
  imageKey    String?
  imageProvider String?
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  availabilityLeads ProductAvailabilityLead[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  position  Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  sku       String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  availabilityLeads ProductAvailabilityLead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductAvailabilityLead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  status    String   @default("waiting")
  preferredContact String?
  source    String?
  notes     String?  @db.Text
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variantKey String @default("product")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customerId Int?
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notifiedAt DateTime?
  convertedAt DateTime?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, status])
  @@index([variantId])
  @@index([customerId])
  @@index([status, createdAt])
  @@unique([productId, email, variantKey])
}

// ==========================================
// ENCOMENDAS (ORDERS) E CHECKOUT
// ==========================================

model Order {
  id         Int         @id @default(autoincrement())
  total      Decimal     @db.Decimal(10, 2)
  status     OrderStatus @default(PENDING)
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  events     OrderEvent[]
  fiscalDocuments FiscalDocument[]
  reverseLogisticsRequests ReverseLogisticsRequest[]
  items      OrderItem[] // Relação: Uma encomenda tem vários itens
  orderNotes String?     @db.Text // Observações/Preferências do cliente (ex: "Com papel de brinde")
  gatewayProvider     String?
  paymentMethod       String?
  gatewayOrderId      String?
  gatewayChargeId     String?
  paymentReference    String?     @db.Text
  paymentStatusDetail String?
  paymentExpiresAt    DateTime?
  expiredAt           DateTime?
  checkoutAttemptId   String?     @db.VarChar(64)
  paidAt              DateTime?
  trackingToken       String?     @unique
  trackingCode        String?
  shippingNotes       String?     @db.Text
  shippingAddress     Json?
  melhorEnvioOrderId  String?
  melhorEnvioProtocol String?
  melhorEnvioStatus   String?
  melhorEnvioLabelUrl String?     @db.Text
  melhorEnvioLabelFilePath String? @db.Text
  melhorEnvioLabelDownloadedAt DateTime?
  melhorEnvioServiceId Int?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  fiscalStatus        String?     @default("pending")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([customerId, checkoutAttemptId])
  @@index([customerId, status])
  @@index([paymentExpiresAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  ncm       String? @db.VarChar(10)
  cfop      String? @db.VarChar(6)
  unit      String?

  @@index([variantId])
}

// Enumeração para os estados da encomenda
enum OrderStatus {
  PENDING         // Aguarda pagamento (PIX ou Cartão)
  PAID            // Pagamento confirmado, aguardando separação
  PAID_STOCK_ISSUE // Pagamento confirmado, mas estoque precisa de revisão manual
  PREPARING       // Separação confirmada pelo lojista
  PACKED          // Pedido embalado, pronto para etiqueta
  LABEL_GENERATED // Etiqueta gerada/liberada para impressão
  POSTED          // Pacote postado
  SHIPPED         // Em transporte
  DELIVERED       // Entregue
  CANCELED        // Cancelado
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model FiscalDocument {
  id              Int       @id @default(autoincrement())
  orderId         Int
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String?
  documentType    String?
  status          String    @default("draft")
  externalId      String?
  number          String?
  series          String?
  accessKey       String?   @db.VarChar(80)
  protocol        String?
  xmlUrl          String?   @db.Text
  danfeUrl        String?   @db.Text
  pdfUrl          String?   @db.Text
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?   @db.Text
  issuedAt        DateTime?
  canceledAt      DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId, createdAt])
  @@index([provider, externalId])
  @@index([status, createdAt])
  @@index([accessKey])
}

model ReverseLogisticsRequest {
  id                Int       @id @default(autoincrement())
  orderId           Int
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String?
  status            String    @default("draft")
  reason            String?
  customerNotes     String?   @db.Text
  internalNotes     String?   @db.Text
  externalId        String?
  protocol          String?
  serviceId         Int?
  trackingCode      String?
  labelUrl          String?   @db.Text
  authorizationCode String?
  pickupAddress     Json?
  returnAddress     Json?
  items             Json?
  requestPayload    Json?
  responsePayload   Json?
  errorMessage      String?   @db.Text
  requestedAt       DateTime?
  authorizedAt      DateTime?
  labelGeneratedAt  DateTime?
  postedAt          DateTime?
  receivedAt        DateTime?
  canceledAt        DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId, createdAt])
  @@index([provider, externalId])
  @@index([status, createdAt])
  @@index([trackingCode])
}

model MelhorEnvioTokenState {
  id                    Int       @id @default(1)
  accessTokenEncrypted  String    @db.Text
  refreshTokenEncrypted String    @db.Text
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  lastRefreshAttemptAt  DateTime?
  lastRefreshSuccessAt  DateTime?
  lastRefreshError      String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MelhorEnvioTokenEvent {
  id        Int      @id @default(autoincrement())
  status    String
  title     String
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model StoreSettings {
  id              Int       @id @default(1)
  adminOrderEmail  String?
  mailFrom         String?
  mailFromName     String?
  storeBaseUrl     String?
  adminBaseUrl     String?
  senderName       String?
  senderPhone      String?
  senderEmail      String?
  senderDocument   String?
  senderAddress    String?
  senderNumber     String?
  senderComplement String?
  senderDistrict   String?
  senderCity       String?
  senderState      String?
  storeZipCode     String?
  storeWeight      String?
  storeLength      String?
  storeWidth       String?
  storeHeight      String?
  pixKey           String?
  pixMerchantName  String?
  pixMerchantCity  String?
  pixProvider      String?
  cardProvider     String?
  companyName      String?
  companyCnpj      String?
  stateRegistration String?
  taxRegime        String?
  updatedAt        DateTime  @updatedAt
}
