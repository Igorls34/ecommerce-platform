# --- Melhor Envio (Sandbox) ---
# Obter client_id e client_secret em https://app.melhorenvio.com.br/integracoes/area-dev
# Gerar tokens via fluxo OAuth2: authorization_code grant para access + refresh token
# O backend renova automaticamente o access_token usando o refresh_token
MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br/api/v2/me
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_REFRESH_TOKEN=
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=
MELHOR_ENVIO_USER_AGENT=Thessara-Store/1.0 (thessarasemijoias@gmail.com)
# Opcional. Intervalo de checagem automatica do token; padrao 6h.
MELHOR_ENVIO_REFRESH_CHECK_INTERVAL_MS=21600000
# Opcional. A geracao de etiqueta e assincrona; configurar tentativas/delay.
MELHOR_ENVIO_LABEL_READY_ATTEMPTS=8
MELHOR_ENVIO_LABEL_READY_INTERVAL_MS=3000

